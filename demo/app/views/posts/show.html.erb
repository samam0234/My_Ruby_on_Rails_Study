<% content_for :title, @post.title %>

<article class="post">
  <p class="eyebrow">게시글</p>
  <h1><%= @post.title %></h1>
  <p class="meta"><%= @post.user&.nickname || "익명" %> · <%= @post.created_at.strftime("%Y-%m-%d %H:%M") %></p>
  <div class="body"><%= simple_format @post.body %></div>
  <div class="row-actions">
    <%= link_to "수정", edit_post_path(@post), class: "button secondary" %>
    <%= button_to "삭제", @post, method: :delete, class: "danger" %>
    <%= link_to "목록", posts_path, class: "button secondary" %>
  </div>
</article>

<section class="card">
  <h2>댓글</h2>
  <% if @comments.empty? %>
    <p class="meta">아직 댓글이 없습니다.</p>
  <% else %>
    <% @comments.each do |comment| %>
      <article class="comment">
        <p><%= comment.body %></p>
        <p class="meta"><%= comment.user&.nickname || "익명" %></p>
        <%= button_to "댓글 삭제", post_comment_path(@post, comment), method: :delete, class: "secondary" %>
      </article>
    <% end %>
  <% end %>

  <%= form_with model: [ @post, Comment.new ] do |form| %>
    <%= form.label :body, "댓글" %>
    <%= form.text_area :body, rows: 3, required: true %>
    <%= form.submit "댓글 남기기" %>
  <% end %>
</section>
